        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(traefik_service_request_duration_seconds_sum{job=\"traefik\"}[5m])) / sum(rate(traefik_service_request_duration_seconds_count{job=\"traefik\"}[5m]))",
          "legendFormat": "Avg Response Time",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Avg Response Time",
      "type": "stat"
