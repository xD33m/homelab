# Copy to .env and fill in. .env is gitignored.

# Cloudflare account used for the DNS-01 challenge and by cloudflare-companion.
CF_API_EMAIL=you@example.com
CF_API_KEY=changeme-cloudflare-global-api-key

# Cloudflare Tunnel id (the CNAME target is <id>.cfargotunnel.com) and zone ids.
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CF_ZONE_ID_PRIMARY=00000000000000000000000000000000
CF_SECONDARY_DOMAIN=example.org
CF_ZONE_ID_SECONDARY=00000000000000000000000000000000

# traefik-oidc-auth (PocketID): session-cookie encryption key and OIDC client id.
# Generate the secret with: openssl rand -hex 32
OIDC_SECRET_POCKETID=changeme-32-byte-hex
POCKETID_CLIENT_ID=00000000-0000-0000-0000-000000000000
