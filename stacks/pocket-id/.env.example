# Copy to .env and fill in. .env is gitignored.
# The live .env is not published. These are minimal settings for running
# Pocket ID behind Traefik; see https://pocket-id.org/docs for the full list.
APP_URL=https://pocketid.lucask.dev
# Traefik terminates TLS in front of Pocket ID.
TRUST_PROXY=true
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=changeme-random-base64
