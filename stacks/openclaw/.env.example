# Copy to .env and fill in. .env is gitignored. The service also loads the
# whole file via env_file.
# The gateway image and tag you run (the live value is not published).
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
GOG_KEYRING_PASSWORD=changeme
XDG_CONFIG_HOME=/home/node/.openclaw
